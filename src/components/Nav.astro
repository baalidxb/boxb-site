---
import Wordmark from './Wordmark.astro';
import BrandMark from './BrandMark.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
const isChangelog = path === '/changelog';

const navItem = (active: boolean) =>
  active
    ? 'relative text-sm text-fg transition-colors after:absolute after:left-0 after:right-0 after:-bottom-1.5 after:h-px after:bg-accent'
    : 'text-sm text-muted-bright transition-colors hover:text-fg';
---

<nav
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
  data-nav
>
  <div class="container-x flex items-center justify-between py-5">
    <a href="/" class="flex items-center gap-2.5 group" aria-label="BoxB home">
      <BrandMark size={26} class="transition-transform duration-300 group-hover:rotate-[60deg]" />
      <Wordmark size="md" />
    </a>

    <div class="hidden items-center gap-10 sm:flex">
      <a
        href={isHome ? '#features' : '/#features'}
        class={navItem(false)}
        >Features</a
      >
      <a
        href={isHome ? '#why' : '/#why'}
        class={navItem(false)}
        >Why BoxB</a
      >
      <a
        href="/changelog"
        class={navItem(isChangelog)}
        aria-current={isChangelog ? 'page' : undefined}
        >Changelog</a
      >
    </div>

    <a
      href="/download/win"
      class="inline-flex items-center gap-1.5 border border-border-bright bg-transparent px-4 py-2 text-sm font-medium text-fg transition-all duration-300 hover:border-accent hover:-translate-y-0.5"
    >
      Download
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
    </a>
  </div>
</nav>

<script>
  const nav = document.querySelector('[data-nav]') as HTMLElement | null;
  if (nav) {
    const update = () => {
      if (window.scrollY > 16) {
        nav.classList.add('nav-scrolled');
      } else {
        nav.classList.remove('nav-scrolled');
      }
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style is:global>
  [data-nav].nav-scrolled {
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    background: rgba(0, 0, 0, 0.55);
    border-bottom: 1px solid rgba(26, 26, 26, 0.8);
  }
</style>
