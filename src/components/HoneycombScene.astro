---
import HoneycombFallback from './HoneycombFallback.astro';
---

<div class="relative h-full w-full" data-honeycomb-root>
  <!-- Fallback that's shown until/unless the WebGL canvas mounts -->
  <div class="absolute inset-0" data-honeycomb-fallback>
    <HoneycombFallback />
  </div>
  <canvas
    class="absolute inset-0 h-full w-full"
    data-honeycomb-canvas
    aria-hidden="true"
    style="display:none;"></canvas>
</div>

<script>
  import type * as THREE from 'three';

  type Cleanup = () => void;
  const cleanups = new Map<HTMLElement, Cleanup>();
  // Defer the runtime three.js import until idle — keeps it out of the LCP path.
  let threePromise: Promise<typeof import('three')> | null = null;
  const loadThree = () => {
    if (!threePromise) threePromise = import('three');
    return threePromise;
  };

  async function init(root: HTMLElement) {
    if (cleanups.has(root)) return;

    const params = new URLSearchParams(window.location.search);
    const forceFallback = params.get('nogl') === '1';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const canvas = root.querySelector(
      '[data-honeycomb-canvas]'
    ) as HTMLCanvasElement | null;
    const fallback = root.querySelector(
      '[data-honeycomb-fallback]'
    ) as HTMLElement | null;
    if (!canvas || !fallback) return;

    if (forceFallback || reducedMotion) {
      // Keep static fallback visible.
      return;
    }

    // Detect WebGL availability
    const gl = (() => {
      try {
        const test = document.createElement('canvas');
        return (
          test.getContext('webgl2') ||
          test.getContext('webgl') ||
          test.getContext('experimental-webgl')
        );
      } catch {
        return null;
      }
    })();
    if (!gl) {
      return;
    }

    const THREE = await loadThree();

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance',
      });
    } catch {
      return;
    }

    canvas.style.display = 'block';
    fallback.style.display = 'none';

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 100);
    camera.position.set(0, 0, 14);

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.setClearColor(0x000000, 0);

    // Lighting
    const ambient = new THREE.AmbientLight(0xffffff, 0.45);
    scene.add(ambient);

    const dir = new THREE.DirectionalLight(0xffffff, 1.6);
    dir.position.set(4, 6, 6);
    scene.add(dir);

    const fill = new THREE.DirectionalLight(0xc9b27a, 0.5);
    fill.position.set(-5, -3, 4);
    scene.add(fill);

    const goldGlow = new THREE.PointLight(0xd4af37, 1.6, 6, 1.6);
    goldGlow.position.set(0, 0, 1.4);
    scene.add(goldGlow);

    // Hex prism geometry (flat-top hexagon)
    const hexShape = new THREE.Shape();
    const hexR = 1;
    for (let i = 0; i < 6; i++) {
      const a = (Math.PI / 3) * i;
      const x = hexR * Math.cos(a);
      const y = hexR * Math.sin(a);
      if (i === 0) hexShape.moveTo(x, y);
      else hexShape.lineTo(x, y);
    }
    hexShape.closePath();

    const extrude = {
      depth: 0.18,
      bevelEnabled: true,
      bevelSegments: 2,
      bevelSize: 0.04,
      bevelThickness: 0.04,
      curveSegments: 1,
    };
    const hexGeo = new THREE.ExtrudeGeometry(hexShape, extrude);
    hexGeo.center();

    // Container group so we can rotate + parallax-tilt independently
    const container = new THREE.Group();
    scene.add(container);

    // Build hex grid (flat-top): center + 2 rings
    const SCALE = 0.85; // unit scale for grid in scene units
    const FW = 2 * SCALE;
    const FH = Math.sqrt(3) * SCALE;

    const positions: { x: number; y: number; ring: number }[] = [
      { x: 0, y: 0, ring: 0 },
    ];
    // ring 1 (6)
    [
      [FW * 0.75, -FH * 0.5],
      [FW * 0.75, FH * 0.5],
      [0, FH],
      [-FW * 0.75, FH * 0.5],
      [-FW * 0.75, -FH * 0.5],
      [0, -FH],
    ].forEach(([x, y]) => positions.push({ x, y, ring: 1 }));
    // ring 2 (12)
    [
      [FW * 1.5, 0],
      [FW * 1.5, -FH],
      [FW * 1.5, FH],
      [FW * 0.75, -FH * 1.5],
      [FW * 0.75, FH * 1.5],
      [0, -FH * 2],
      [0, FH * 2],
      [-FW * 0.75, -FH * 1.5],
      [-FW * 0.75, FH * 1.5],
      [-FW * 1.5, 0],
      [-FW * 1.5, -FH],
      [-FW * 1.5, FH],
    ].forEach(([x, y]) => positions.push({ x, y, ring: 2 }));

    // Subtle tints — abstract color hints, not literal logos
    const ringTints = [
      0x2a3a2a, 0x223252, 0x3a2832, 0x223a3a, 0x3a3622, 0x2c2238,
      0x1a1a1a, 0x161616, 0x1f1f1f, 0x181818, 0x1c1c1c, 0x171717,
    ];

    const meshes: THREE.Mesh[] = [];
    const centerHexMat = new THREE.MeshStandardMaterial({
      color: 0xd4af37,
      metalness: 0.85,
      roughness: 0.22,
      emissive: 0xd4af37,
      emissiveIntensity: 0.18,
    });

    let centerMesh: THREE.Mesh | undefined;

    positions.forEach((p, idx) => {
      let mat: THREE.MeshStandardMaterial;
      let scale = 1;
      let z = 0;

      if (p.ring === 0) {
        mat = centerHexMat;
        scale = 1;
      } else if (p.ring === 1) {
        const tint = ringTints[idx % ringTints.length];
        mat = new THREE.MeshStandardMaterial({
          color: tint,
          metalness: 0.35,
          roughness: 0.55,
          transparent: true,
          opacity: 0.9,
        });
        scale = 0.85;
        z = -0.05;
      } else {
        const tint = ringTints[(idx + 3) % ringTints.length];
        mat = new THREE.MeshStandardMaterial({
          color: tint,
          metalness: 0.25,
          roughness: 0.7,
          transparent: true,
          opacity: 0.55,
        });
        scale = 0.75;
        z = -0.18;
      }

      const m = new THREE.Mesh(hexGeo, mat);
      m.position.set(p.x, p.y, z);
      m.scale.setScalar(scale);
      // Random subtle tilt for non-center hexes
      if (p.ring !== 0) {
        m.rotation.x = (Math.random() - 0.5) * 0.08;
        m.rotation.y = (Math.random() - 0.5) * 0.08;
      }
      container.add(m);
      meshes.push(m);
      if (p.ring === 0) centerMesh = m;
    });

    // Black bars on center hex (the BoxB mark) — built as two flat boxes layered on the front face
    if (centerMesh) {
      const barGeo = new THREE.PlaneGeometry(1.18, 0.11);
      const barMat = new THREE.MeshBasicMaterial({ color: 0x000000 });
      const bar1 = new THREE.Mesh(barGeo, barMat);
      const bar2 = new THREE.Mesh(barGeo, barMat);
      bar1.position.set(0, 0.135, 0.16);
      bar2.position.set(0, -0.2, 0.16);
      centerMesh.add(bar1);
      centerMesh.add(bar2);
    }

    // Initial container tilt for cinematic perspective
    container.rotation.x = -0.18;

    // Mouse parallax — max 5deg
    const targetTilt = { x: 0, y: 0 };
    const onPointer = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = (e.clientX - cx) / (rect.width / 2);
      const dy = (e.clientY - cy) / (rect.height / 2);
      const max = (5 * Math.PI) / 180;
      targetTilt.x = THREE.MathUtils.clamp(dy, -1, 1) * -max;
      targetTilt.y = THREE.MathUtils.clamp(dx, -1, 1) * max;
    };
    window.addEventListener('pointermove', onPointer, { passive: true });

    // Scroll: fade + recede past hero
    let scrollProgress = 0;
    const onScroll = () => {
      const heroHeight = window.innerHeight;
      scrollProgress = THREE.MathUtils.clamp(window.scrollY / heroHeight, 0, 1);
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    // Resize handling
    const ro = new ResizeObserver((entries) => {
      const e = entries[0];
      if (!e) return;
      const { width, height } = e.contentRect;
      if (width === 0 || height === 0) return;
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    });
    ro.observe(root);

    // Pause when off-screen
    let visible = true;
    const io = new IntersectionObserver(
      (entries) => {
        for (const ent of entries) visible = ent.isIntersecting;
      },
      { threshold: 0 }
    );
    io.observe(root);

    let raf = 0;
    let last = performance.now();
    let baseRotY = 0;
    let breathPhase = 0;

    const animate = () => {
      raf = requestAnimationFrame(animate);
      if (!visible) return;
      const now = performance.now();
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;

      // Slow rotation — ~20s per full revolution on Y
      baseRotY += dt * ((Math.PI * 2) / 20);

      // Smooth tilt toward target
      const tiltLerp = 0.06;
      container.rotation.y += (targetTilt.y + baseRotY * 0.5 - container.rotation.y) * tiltLerp;
      // Combine static cinematic tilt + parallax
      container.rotation.x += (-0.18 + targetTilt.x - container.rotation.x) * tiltLerp;

      // Center breathing scale (~±2% over 4s)
      breathPhase += dt;
      if (centerMesh) {
        const s = 1 + Math.sin(breathPhase * (Math.PI * 2) / 4) * 0.02;
        centerMesh.scale.setScalar(s);
      }

      // Scroll fade/recede
      const recede = scrollProgress;
      camera.position.z = 14 + recede * 6;
      const fade = 1 - recede;
      meshes.forEach((m) => {
        const mat = m.material as THREE.MeshStandardMaterial;
        if (mat.transparent) {
          mat.opacity = (mat.userData.baseOpacity ?? mat.opacity) * fade;
        }
      });
      // Also fade emissive on center hex
      if (centerHexMat) {
        centerHexMat.emissiveIntensity = 0.18 * fade;
      }

      renderer.render(scene, camera);
    };

    // store base opacities so fade math is stable
    meshes.forEach((m) => {
      const mat = m.material as THREE.MeshStandardMaterial;
      if (mat.transparent) mat.userData.baseOpacity = mat.opacity;
    });

    animate();

    cleanups.set(root, () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('pointermove', onPointer);
      window.removeEventListener('scroll', onScroll);
      ro.disconnect();
      io.disconnect();
      meshes.forEach((m) => {
        if (m.geometry !== hexGeo) m.geometry.dispose();
        const mat = m.material as THREE.Material | THREE.Material[];
        if (Array.isArray(mat)) mat.forEach((mm) => mm.dispose());
        else mat.dispose();
      });
      hexGeo.dispose();
      renderer.dispose();
    });
  }

  function boot() {
    const ric =
      (window as unknown as { requestIdleCallback?: (cb: () => void) => void })
        .requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 1));
    ric(() => {
      document
        .querySelectorAll<HTMLElement>('[data-honeycomb-root]')
        .forEach((el) => init(el));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
