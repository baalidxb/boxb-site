---
import MockSidebar from '~/components/mocks/MockSidebar.astro';
import MockMultiwindow from '~/components/mocks/MockMultiwindow.astro';
import MockGrid from '~/components/mocks/MockGrid.astro';

const blocks = [
  {
    n: '01',
    title: 'Every app. Every account. 1 window.',
    body: 'WhatsApp, Telegram, Slack, Gmail — add as many of each as you need. Five WhatsApp numbers? Each gets its own tile, its own login, its own session. No juggling phones.',
    Mock: MockSidebar,
  },
  {
    n: '02',
    title: '3 monitors. 3 companies.',
    body: 'Drop a workspace into its own window and lock it to a screen. Your CEO context stays on the left, your client work on the right.',
    Mock: MockMultiwindow,
  },
  {
    n: '03',
    title: '29 services. Zero tabs.',
    body: 'Slack, Notion, Linear, Gmail, Teams, calendars — pick from the catalog or paste any URL. They all run side-by-side, native and instant.',
    Mock: MockGrid,
  },
];
---

<section id="what" class="relative py-32 sm:py-40">
  <div class="container-x">
    <header class="mb-20 max-w-3xl">
      <p class="reveal mb-5 font-mono text-xs uppercase tracking-[0.25em] text-accent">
        ◆ What it is
      </p>
      <h2
        class="reveal reveal-delay-1 font-display font-extrabold text-display-lg text-fg"
      >
        Built for the chaos.
      </h2>
      <p class="reveal reveal-delay-2 mt-6 text-lede text-muted-bright">
        If you run multiple work tools, multiple accounts, or multiple
        companies — BoxB is your single window for all of them.
      </p>
    </header>

    <div class="space-y-24 md:space-y-32">
      {
        blocks.map((b, i) => (
          <article
            class={`grid grid-cols-1 items-center gap-10 md:gap-16 lg:grid-cols-12 ${i % 2 === 1 ? 'lg:[&>div:first-child]:order-2' : ''}`}
          >
            <div class="reveal lg:col-span-5">
              <p class="font-mono text-xs uppercase tracking-[0.25em] text-accent">
                {b.n}
              </p>
              <h3 class="mt-3 font-display font-extrabold text-display-md text-fg">
                {b.title}
              </h3>
              <p class="mt-5 max-w-md text-base text-muted-bright sm:text-lg">
                {b.body}
              </p>
            </div>
            <div class="reveal reveal-delay-2 lg:col-span-7">
              <div class="relative aspect-[16/10] w-full overflow-hidden border border-border bg-surface">
                <b.Mock />
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-black/40 via-transparent to-black/30"></div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
