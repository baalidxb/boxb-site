---
const cols = [
  {
    glyph: 'lockin',
    title: 'Other tools force you in.',
    body:
      'Most messengers want to be your daily driver. They push notifications, suggest you use them more, lock data behind their UI. You end up serving the tool.',
  },
  {
    glyph: 'window',
    title: 'BoxB stays out of your way.',
    body:
      'BoxB is just the container. Your services run as they always have — same login, same data, same notifications. We just put them in one frame.',
  },
  {
    glyph: 'shield',
    title: 'Your accounts. Your data. Your hardware.',
    body:
      "Local-first. No cloud sync, no telemetry, no account required. What's on your screen lives on your machine, not ours.",
  },
];
---

<section
  id="why"
  class="relative py-32 sm:py-40 border-t border-border bg-surface/30"
>
  <div class="container-x">
    <header class="mb-20 max-w-3xl">
      <p class="reveal mb-5 font-mono text-xs uppercase tracking-[0.25em] text-accent">
        ◆ Why BoxB
      </p>
      <h2
        class="reveal reveal-delay-1 font-display font-extrabold text-display-lg text-fg"
      >
        What's been missing.
      </h2>
    </header>

    <div class="grid grid-cols-1 gap-12 md:grid-cols-3 md:gap-0">
      {
        cols.map((c, i) => (
          <div
            class={`reveal reveal-delay-${i + 1} relative px-0 md:px-8 ${i > 0 ? 'md:border-l md:border-accent/25' : ''}`}
          >
            <div class="mb-8 flex h-10 w-10 items-center justify-center text-accent">
              {c.glyph === 'lockin' && (
                <svg width="34" height="34" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="6" y="6" width="20" height="20" />
                  <path d="M6 6 L26 26 M26 6 L6 26" opacity="0.5" />
                </svg>
              )}
              {c.glyph === 'window' && (
                <svg width="34" height="34" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="16,4 27,10 27,22 16,28 5,22 5,10" />
                  <line x1="5" y1="13" x2="27" y2="13" />
                  <line x1="5" y1="19" x2="27" y2="19" />
                </svg>
              )}
              {c.glyph === 'shield' && (
                <svg width="34" height="34" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 4 L26 8 L26 16 C26 22 21 27 16 28 C11 27 6 22 6 16 L6 8 Z" />
                  <path d="M11 16 L15 20 L21 12" />
                </svg>
              )}
            </div>
            <h3 class="font-display text-2xl font-bold tracking-tight text-fg sm:text-3xl">
              {c.title}
            </h3>
            <p class="mt-5 max-w-sm text-base leading-relaxed text-muted-bright">
              {c.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
