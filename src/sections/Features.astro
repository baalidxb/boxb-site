---
const features = [
  {
    n: '01',
    title: 'Workspaces',
    body:
      'Group services by company, project, or context. Switch with one keystroke.',
    icon: 'workspaces',
  },
  {
    n: '02',
    title: 'Multi-window',
    body:
      'Right-click any workspace, open it in a new window. Lock it there forever.',
    icon: 'multiwindow',
  },
  {
    n: '03',
    title: 'Per-instance rename',
    body:
      'Five WhatsApps? Label them ABC-Sales, ABC-Support, DEF-Sales — never confuse them again.',
    icon: 'rename',
  },
  {
    n: '04',
    title: 'Smart hibernation',
    body:
      'Idle services freeze quietly to save RAM. Active ones never miss a beat.',
    icon: 'hibernate',
  },
  {
    n: '05',
    title: 'Custom toasts',
    body:
      'Notifications that actually look like they belong on your desktop, not Windows 95.',
    icon: 'toast',
  },
  {
    n: '06',
    title: 'Custom URLs',
    body:
      "Don't see your tool? Add any web app with a URL. We handle the rest.",
    icon: 'url',
  },
  {
    n: '07',
    title: 'AI Command Bar',
    body:
      '“Open WhatsApp.” “Remind me to call Ali at 5pm.” Ctrl+K, type it, done.',
    icon: 'command',
  },
  {
    n: '08',
    title: 'Ask AI anywhere',
    body:
      'Select any message, right-click: summarize, translate, or draft a reply. Works in every service.',
    icon: 'spark',
  },
  {
    n: '09',
    title: 'Calendar & Meeting Briefs',
    body:
      'All your calendars in one agenda, and a heads-up 15 minutes before every meeting — with AI prep notes.',
    icon: 'calendar',
  },
] as const;
---

<section id="features" class="relative py-32 sm:py-40 border-t border-border">
  <div class="container-x">
    <header class="mb-20 max-w-3xl">
      <p class="reveal mb-5 font-mono text-xs uppercase tracking-[0.25em] text-accent">
        ◆ Features
      </p>
      <h2
        class="reveal reveal-delay-1 font-display font-extrabold text-display-lg text-fg xl:whitespace-nowrap"
      >
        Every detail, considered.
      </h2>
      <p class="reveal reveal-delay-2 mt-6 max-w-xl text-lede text-muted-bright">
        BoxB is a desktop-first product. Every feature exists because someone
        running ten messengers a day asked for it.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-px bg-border md:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f, i) => (
          <article
            class={`feature-card reveal reveal-delay-${(i % 3) + 1} group relative bg-bg p-8 transition-colors duration-500 hover:bg-surface sm:p-10`}
          >
            <div class="mb-7 flex h-12 w-12 items-center justify-center border border-accent/40 bg-bg transition-colors duration-300 group-hover:border-accent">
              {f.icon === 'workspaces' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7" />
                  <rect x="14" y="3" width="7" height="7" />
                  <rect x="14" y="14" width="7" height="7" />
                  <rect x="3" y="14" width="7" height="7" />
                </svg>
              )}
              {f.icon === 'multiwindow' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="13" height="13" />
                  <rect x="9" y="9" width="13" height="13" fill="#000" />
                </svg>
              )}
              {f.icon === 'rename' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20h9" />
                  <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4z" />
                </svg>
              )}
              {f.icon === 'hibernate' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 6v6l4 2" />
                </svg>
              )}
              {f.icon === 'toast' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="6" width="18" height="12" rx="1" />
                  <path d="M3 10h18" />
                  <circle cx="6.5" cy="8" r="0.6" fill="#D4AF37" />
                  <path d="M7 14h6" />
                </svg>
              )}
              {f.icon === 'url' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07L11.5 4.5" />
                  <path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07L12.5 19.5" />
                </svg>
              )}
              {f.icon === 'command' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3z" />
                </svg>
              )}
              {f.icon === 'spark' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3v6" />
                  <path d="M12 15v6" />
                  <path d="M3 12h6" />
                  <path d="M15 12h6" />
                  <path d="M5.5 5.5l3 3" />
                  <path d="M15.5 15.5l3 3" />
                  <path d="M5.5 18.5l3-3" />
                  <path d="M15.5 8.5l3-3" />
                </svg>
              )}
              {f.icon === 'calendar' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" />
                  <line x1="16" y1="2" x2="16" y2="6" />
                  <line x1="8" y1="2" x2="8" y2="6" />
                  <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
              )}
            </div>
            <h3 class="font-display text-xl font-bold tracking-tight text-fg sm:text-2xl">
              {f.title}
            </h3>
            <p class="mt-3 max-w-sm text-base leading-relaxed text-muted-bright">
              {f.body}
            </p>
            <span class="pointer-events-none absolute inset-x-0 bottom-0 h-px scale-x-0 bg-accent transition-transform duration-500 group-hover:scale-x-100"></span>
          </article>
        ))
      }
      <!-- Filler CTA card: keeps the grid perfectly full at 2-col (10th cell)
           and at 3-col (spans the last two cells of row 4). -->
      <a
        href="/download/win"
        class="feature-card reveal reveal-delay-1 group relative flex flex-col justify-center bg-bg p-8 transition-colors duration-500 hover:bg-surface sm:p-10 md:col-span-1 lg:col-span-2"
      >
        <p class="font-display text-xl font-bold tracking-tight text-fg sm:text-2xl">
          …and <span class="text-accent">29 services</span> to run them in.
        </p>
        <p class="mt-3 max-w-md text-base leading-relaxed text-muted-bright">
          Workspaces for every company. Hibernation for your RAM. One download
          for all of it.
        </p>
        <p class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-accent">
          Get BoxB — free during beta
          <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </p>
        <span class="pointer-events-none absolute inset-x-0 bottom-0 h-px scale-x-0 bg-accent transition-transform duration-500 group-hover:scale-x-100"></span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Override the gap-px background to feel like hairlines on hover */
  .feature-card {
    position: relative;
  }
</style>
